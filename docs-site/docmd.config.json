{
  "title": "Laravel Mobile Push",
  "description": "APNs, FCM and Live Activities for Laravel: send push notifications directly to Apple and Google over HTTP/2, and always know what happened to each one.",
  "url": "https://doc.laravel-mobile-push.padosoft.com",
  "src": "docs",
  "out": "_site",
  "base": "/",
  "favicon": "assets/favicon.svg",
